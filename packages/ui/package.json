{
  "name": "@workspace/ui",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "shadcn/ui components (style base-nova, Base UI primitives), globals.css, hooks, and the cn re-export for VisitProof.",
  "license": "Apache-2.0",
  "scripts": {
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "0.4.0",
    "date-fns": "4.4.0",
    "input-otp": "^1.5.0",
    "lucide-react": "1.48.0",
    "next-themes": "0.4.6",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "recharts": "3.10.1",
    "shadcn": "4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@visitproof/config": "workspace:*",
    "eslint": "9.39.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./postcss.config": "./postcss.config.mjs",
    "./lib/*": "./src/lib/*.ts",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts"
  }
