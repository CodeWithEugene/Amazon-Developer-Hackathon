{
  "name": "@visitproof/config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared tsconfig, ESLint flat configs, Prettier config, and the Zod environment schema for VisitProof.",
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/env.ts",
    "./prettier": "./prettier.config.mjs",
    "./eslint/base": "./eslint/base.js",
    "./eslint/node": "./eslint/node.js",
    "./eslint/next": "./eslint/next.js",
    "./eslint/react-internal": "./eslint/react-internal.js",
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./tsconfig.node.json": "./tsconfig.node.json",
    "./tsconfig.nextjs.json": "./tsconfig.nextjs.json",
    "./tsconfig.react-library.json": "./tsconfig.react-library.json"
  },
  "files": [
    "src",
    "eslint",
    "prettier.config.mjs",
    "tsconfig.*.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.3.6",
    "@types/node": "26.6.3",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-only-warn": "1.2.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-turbo": "2.11.4",
    "globals": "17.12.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2"
  }
}
