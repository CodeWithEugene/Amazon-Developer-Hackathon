{
  "name": "@visitproof/ring-partner-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Ring Partner API: client, Zod schemas, webhook verification and lenient parsing, account link nonce, WHEP live view helper, snapshot handling, webhook emulator, and fixture redaction.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./whep": "./src/whep.ts",
    "./testing": "./src/testing/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./whep": {
        "types": "./dist/whep.d.ts",
        "import": "./dist/whep.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "ring:smoke": "tsx ../../scripts/ring-smoke.ts",
    "mock:playground": "tsx src/testing/mock-playground.ts"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@visitproof/config": "workspace:*",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "9.39.5",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  },
  "keywords": [
    "ring",
    "ring-partner-api",
    "webhooks",
    "whep",
    "amazon",
    "visitproof"
  ]
}
