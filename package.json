{
  "name": "visitproof",
  "version": "0.1.0",
  "private": true,
  "description": "Proof of presence for home care, from the doorbell already at the door.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "demo": "tsx scripts/demo.ts",
    "mcp:conformance": "pnpm --filter @visitproof/mcp test:conformance"
  },
  "prettier": "@visitproof/config/prettier",
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@visitproof/config": "workspace:*",
    "@visitproof/db": "workspace:*",
    "@visitproof/domain": "workspace:*",
    "@visitproof/ring-partner-sdk": "workspace:*",
    "eslint": "9.39.5",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "turbo": "2.11.4",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
